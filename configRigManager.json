{
  "version": "2.0",
  "settings": {
    "poll_interval_seconds": 300,
    "report_dir": "reports",
    "what_to_mine_url": "https://whattomine.com/coins.json",
    "pool_url_template": "https://miningpoolstats.stream/{tag}",
    "allow_launch": true,
    "min_profit_delta_percent": 5.0
  },
  "coins": {
    "EthereumPoW": {
      "tag": "ethereumpow",
      "miner_tool": {
        "directory": "miners/trex",
        "executable": "t-rex.exe"
      },
      "options": {
        "-a": "ethash",
        "-o": "reserved",
        "-u": "0xbd3fc8a435e4bb3497c7330ed7672fc866f91dcb",
        "-p": "x"
      }
    },
    "EthereumClassic": {
      "tag": "etc",
      "miner_tool": {
        "directory": "miners/trex",
        "executable": "t-rex.exe"
      },
      "options": {
        "-a": "etchash",
        "-o": "reserved",
        "-u": "0xbd3fc8a435e4bb3497c7330ed7672fc866f91dcb",
        "-p": "x"
      }
    },
    "Ravencoin": {
      "tag": "rvn",
      "miner_tool": {
        "directory": "miners/trex",
        "executable": "t-rex.exe"
      },
      "options": {
        "-a": "kawpow",
        "-o": "reserved",
        "-u": "0xbd3fc8a435e4bb3497c7330ed7672fc866f91dcb",
        "-p": "x"
      }
    }
  }
}
